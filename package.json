{
  "name": "vitrine-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Compose-style inline preview for React components, inside the editor.",
  "scripts": {
    "build": "pnpm --filter @vitrine/vite-plugin build",
    "build:extension": "pnpm --filter vitrine build",
    "test:package": "pnpm --filter @vitrine/vite-plugin test:package",
    "test:extension-package": "pnpm --filter vitrine test:package",
    "dev:example": "pnpm --filter example dev",
    "dev:example2": "pnpm --filter example2 dev",
    "dev:host": "node scripts/dev-host.mjs",
    "test": "pnpm --filter @vitrine/protocol build && vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
