{
  "name": "@vitrine/vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin that scans @preview-annotated exports and serves a live preview gallery.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --filter @vitrine/protocol build && tsc -p tsconfig.json && tsc -p client/tsconfig.json && node scripts/build-client.mjs",
    "dev": "pnpm --filter @vitrine/protocol build && tsc -p tsconfig.json --watch",
    "dev:client": "pnpm --filter @vitrine/protocol build && node scripts/build-client.mjs --watch",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@vitrine/protocol": "workspace:*",
    "@babel/parser": "^7.25.9",
    "@babel/traverse": "^7.25.9",
    "fast-glob": "^3.3.2",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@vitrine/typescript-config": "workspace:*",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "vite": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
