{
  "name": "vite-plugin-react-vitrine",
  "version": "0.1.0",
  "description": "Vite plugin that scans @preview-annotated exports and serves a live preview gallery.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --filter @vitrine/protocol build && node scripts/build-package.mjs && tsc -p client/tsconfig.json && node scripts/build-client.mjs",
    "dev": "pnpm --filter @vitrine/protocol build && tsc -p tsconfig.json --watch",
    "dev:client": "pnpm --filter @vitrine/protocol build && node scripts/build-client.mjs --watch",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@babel/parser": "catalog:babel",
    "@babel/traverse": "catalog:babel",
    "fast-glob": "^3.3.2",
    "typescript": "catalog:typescript"
  },
  "devDependencies": {
    "@vitrine/protocol": "workspace:*",
    "@vitrine/typescript-config": "workspace:*",
    "@types/babel__traverse": "catalog:babel",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "esbuild": "catalog:build",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite"
  },
  "peerDependencies": {
    "vite": "^6.4.0 || ^7.0.0 || ^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
