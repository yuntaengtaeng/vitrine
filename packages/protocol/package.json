{
  "name": "@vitrine/protocol",
  "version": "0.1.0",
  "description": "Runtime-neutral contracts shared by Vitrine packages.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cjs.mjs"
  },
  "devDependencies": {
    "@vitrine/typescript-config": "workspace:*",
    "esbuild": "catalog:build",
    "typescript": "catalog:typescript"
  }
}
